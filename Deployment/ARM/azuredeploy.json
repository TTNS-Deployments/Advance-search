{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "8508727022158572313"
    },
    "description": "Advance Search: meaning-based search over PDF, Word and Excel documents (web app, Blob Storage, Azure OpenAI embeddings, Azure AI Search, Key Vault, monitoring)."
  },
  "parameters": {
    "solutionPrefix": {
      "type": "string",
      "defaultValue": "advsrch",
      "minLength": 3,
      "maxLength": 8,
      "metadata": {
        "description": "Short lowercase alphanumeric prefix for all resource names (3-8 characters)."
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "demo",
        "dev",
        "test",
        "uat",
        "prod"
      ],
      "metadata": {
        "description": "Environment name, used in resource names and tags."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for all resources except Azure OpenAI (see openAiLocation). With an existing App Service plan, this must be the plan's region."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Extra tags applied to every resource."
      }
    },
    "storageSku": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_ZRS",
        "Standard_GRS",
        "Standard_RAGRS",
        "Standard_GZRS"
      ],
      "metadata": {
        "description": "Storage redundancy."
      }
    },
    "allowSharedKeyAccess": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Allow storage account keys (shared key). Needed by Deployment/scripts/deploy_code_arm.sh, which uploads the code package with the account key."
      }
    },
    "blobSoftDeleteDays": {
      "type": "int",
      "defaultValue": 7,
      "minValue": 1,
      "maxValue": 365,
      "metadata": {
        "description": "Days that deleted blobs and containers can be restored (soft delete)."
      }
    },
    "logAnalyticsRetentionDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 30,
      "maxValue": 730,
      "metadata": {
        "description": "Log Analytics retention in days."
      }
    },
    "logAnalyticsDailyQuotaGb": {
      "type": "int",
      "defaultValue": 1,
      "minValue": -1,
      "metadata": {
        "description": "Log Analytics daily ingestion cap in GB (-1 = no cap)."
      }
    },
    "keyVaultSku": {
      "type": "string",
      "defaultValue": "standard",
      "allowedValues": [
        "standard",
        "premium"
      ],
      "metadata": {
        "description": "Key Vault tier."
      }
    },
    "openAiLocation": {
      "type": "string",
      "defaultValue": "southindia",
      "metadata": {
        "description": "Region of the Azure OpenAI resource. Must offer the embedding model and deployment type, with quota in your subscription."
      }
    },
    "embeddingModelName": {
      "type": "string",
      "defaultValue": "text-embedding-3-small",
      "metadata": {
        "description": "Embedding model (for example text-embedding-3-small or text-embedding-3-large)."
      }
    },
    "embeddingModelVersion": {
      "type": "string",
      "defaultValue": "1",
      "metadata": {
        "description": "Embedding model version."
      }
    },
    "embeddingDeploymentSku": {
      "type": "string",
      "defaultValue": "GlobalStandard",
      "allowedValues": [
        "Standard",
        "GlobalStandard",
        "DataZoneStandard"
      ],
      "metadata": {
        "description": "Deployment type of the embedding model."
      }
    },
    "embeddingCapacity": {
      "type": "int",
      "defaultValue": 10,
      "minValue": 1,
      "metadata": {
        "description": "Embedding deployment capacity in thousands of tokens per minute."
      }
    },
    "embeddingDimensions": {
      "type": "int",
      "defaultValue": 1536,
      "minValue": 256,
      "maxValue": 3072,
      "metadata": {
        "description": "Vector size. 1536 for text-embedding-3-small, 3072 for text-embedding-3-large (or a smaller value; text-embedding-3 models can shorten vectors). Changing it needs an index rebuild."
      }
    },
    "openAiApiVersion": {
      "type": "string",
      "defaultValue": "2024-10-21",
      "metadata": {
        "description": "Azure OpenAI API version used for embeddings."
      }
    },
    "searchSku": {
      "type": "string",
      "defaultValue": "basic",
      "allowedValues": [
        "free",
        "basic",
        "standard",
        "standard2",
        "standard3"
      ],
      "metadata": {
        "description": "Azure AI Search tier. Free: one per subscription, no semantic ranker, no private endpoints, 50 MB."
      }
    },
    "searchReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 12,
      "metadata": {
        "description": "Search replicas (free: 1; basic: up to 3)."
      }
    },
    "searchPartitions": {
      "type": "int",
      "defaultValue": 1,
      "allowedValues": [
        1,
        2,
        3,
        4,
        6,
        12
      ],
      "metadata": {
        "description": "Search partitions (free and basic: 1)."
      }
    },
    "searchSemanticSearch": {
      "type": "string",
      "defaultValue": "free",
      "allowedValues": [
        "disabled",
        "free",
        "standard"
      ],
      "metadata": {
        "description": "Semantic ranker plan. free = 1,000 semantic queries per month; ignored on the free search tier."
      }
    },
    "searchIndexName": {
      "type": "string",
      "defaultValue": "advance-search",
      "metadata": {
        "description": "Name of the search index (created by the web app)."
      }
    },
    "existingAppServicePlanId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of an existing Linux App Service plan to host the web app. Empty = create a new plan. An existing plan is never modified."
      }
    },
    "webAppSku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "B3",
        "S1",
        "S2",
        "S3",
        "P0v3",
        "P1v3",
        "P2v3",
        "P3v3"
      ],
      "metadata": {
        "description": "App Service plan SKU (only when a new plan is created)."
      }
    },
    "webAppInstanceCount": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Number of plan instances (only when a new plan is created)."
      }
    },
    "maxUploadMb": {
      "type": "int",
      "defaultValue": 20,
      "minValue": 1,
      "maxValue": 100,
      "metadata": {
        "description": "Largest upload in MB."
      }
    },
    "displayTimeZone": {
      "type": "string",
      "defaultValue": "Asia/Kolkata",
      "metadata": {
        "description": "Time zone for dates shown in the web app."
      }
    },
    "authMode": {
      "type": "string",
      "defaultValue": "password",
      "allowedValues": [
        "password"
      ],
      "metadata": {
        "description": "Sign-in mode. password = one shared demo password plus a role choice (Admin or User)."
      }
    },
    "demoPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Shared demo password, stored in Key Vault as demo-password. Leave empty on redeploys to keep the current one."
      }
    },
    "djangoSecretKey": {
      "type": "securestring",
      "defaultValue": "[newGuid()]",
      "metadata": {
        "description": "Django secret key. Generated on every deployment unless given (a new key signs everyone out)."
      }
    },
    "deployerPrincipalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object ID of the identity running the deployment; gets Storage Blob Data Contributor and Key Vault Secrets Officer. Empty = skip."
      }
    },
    "deployerPrincipalType": {
      "type": "string",
      "defaultValue": "User",
      "allowedValues": [
        "User",
        "ServicePrincipal",
        "Group"
      ],
      "metadata": {
        "description": "Type of deployerPrincipalId."
      }
    },
    "privateNetworking": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Private endpoints for Blob Storage, AI Search, Azure OpenAI and Key Vault; the web app reaches them through VNet integration and they refuse public traffic. Needs a Basic or higher search tier."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.60.0.0/16",
      "metadata": {
        "description": "VNet address range (private networking only)."
      }
    },
    "appSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.60.1.0/24",
      "metadata": {
        "description": "Subnet for the web app's VNet integration (private networking only)."
      }
    },
    "privateEndpointSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.60.2.0/24",
      "metadata": {
        "description": "Subnet for the private endpoints (private networking only)."
      }
    }
  },
  "variables": {
    "suffix": "[take(uniqueString(resourceGroup().id, parameters('solutionPrefix'), parameters('environmentName')), 6)]",
    "prefix": "[toLower(parameters('solutionPrefix'))]",
    "baseName": "[format('{0}-{1}-{2}', variables('prefix'), parameters('environmentName'), variables('suffix'))]",
    "names": {
      "keyVault": "[format('{0}-kv', variables('baseName'))]",
      "storage": "[take(format('{0}{1}{2}st', variables('prefix'), parameters('environmentName'), variables('suffix')), 24)]",
      "logs": "[format('{0}-log', variables('baseName'))]",
      "appInsights": "[format('{0}-appi', variables('baseName'))]",
      "openAi": "[format('{0}-openai', variables('baseName'))]",
      "search": "[format('{0}-search', variables('baseName'))]",
      "plan": "[format('{0}-plan', variables('baseName'))]",
      "web": "[format('{0}-web', variables('baseName'))]",
      "vnet": "[format('{0}-vnet', variables('baseName'))]"
    },
    "allTags": "[union(parameters('tags'), createObject('solution', 'advance-search', 'environment', parameters('environmentName')))]",
    "containers": [
      "documents",
      "config",
      "code-packages"
    ],
    "createPlan": "[empty(parameters('existingAppServicePlanId'))]",
    "planTiers": {
      "B1": "Basic",
      "B2": "Basic",
      "B3": "Basic",
      "S1": "Standard",
      "S2": "Standard",
      "S3": "Standard",
      "P0v3": "Premium0V3",
      "P1v3": "PremiumV3",
      "P2v3": "PremiumV3",
      "P3v3": "PremiumV3"
    },
    "startupCommand": "python -m gunicorn --bind=0.0.0.0:8000 --timeout 600 --workers 1 --threads 4 config.wsgi",
    "roles": {
      "blobDataContributor": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
      "openAiUser": "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd",
      "searchIndexDataContributor": "8ebe5a00-799e-43f5-93ac-243d3dce84a7",
      "searchServiceContributor": "7ca78c08-252a-4471-8644-bb5ff32d4ba0",
      "keyVaultSecretsUser": "4633458b-17de-408a-b874-0445c86b69e6",
      "keyVaultSecretsOfficer": "b86a8fe4-44ce-4948-aee5-eccb2c155cd7"
    },
    "publicAccess": "[if(parameters('privateNetworking'), 'Disabled', 'Enabled')]",
    "semanticSetting": "[if(equals(parameters('searchSku'), 'free'), createObject(), createObject('semanticSearch', parameters('searchSemanticSearch')))]",
    "privateLinks": [
      {
        "name": "blob",
        "id": "[resourceId('Microsoft.Storage/storageAccounts', variables('names').storage)]",
        "group": "blob",
        "zone": "[format('privatelink.blob.{0}', environment().suffixes.storage)]"
      },
      {
        "name": "search",
        "id": "[resourceId('Microsoft.Search/searchServices', variables('names').search)]",
        "group": "searchService",
        "zone": "privatelink.search.windows.net"
      },
      {
        "name": "openai",
        "id": "[resourceId('Microsoft.CognitiveServices/accounts', variables('names').openAi)]",
        "group": "account",
        "zone": "privatelink.openai.azure.com"
      },
      {
        "name": "vault",
        "id": "[resourceId('Microsoft.KeyVault/vaults', variables('names').keyVault)]",
        "group": "vault",
        "zone": "privatelink.vaultcore.azure.net"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('names').keyVault]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "[parameters('keyVaultSku')]"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "[variables('publicAccess')]",
        "networkAcls": {
          "defaultAction": "[if(parameters('privateNetworking'), 'Deny', 'Allow')]",
          "bypass": "AzureServices"
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('names').keyVault, 'django-secret-key')]",
      "properties": {
        "value": "[parameters('djangoSecretKey')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('names').keyVault)]"
      ]
    },
    {
      "condition": "[not(empty(parameters('demoPassword')))]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('names').keyVault, 'demo-password')]",
      "properties": {
        "value": "[parameters('demoPassword')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('names').keyVault)]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('names').storage]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "kind": "StorageV2",
      "sku": {
        "name": "[parameters('storageSku')]"
      },
      "properties": {
        "accessTier": "Hot",
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": "[parameters('allowSharedKeyAccess')]",
        "publicNetworkAccess": "[variables('publicAccess')]",
        "networkAcls": {
          "defaultAction": "[if(parameters('privateNetworking'), 'Deny', 'Allow')]",
          "bypass": "AzureServices"
        },
        "encryption": {
          "keySource": "Microsoft.Storage",
          "services": {
            "blob": {
              "enabled": true
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('names').storage, 'default')]",
      "properties": {
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": "[parameters('blobSoftDeleteDays')]"
        },
        "containerDeleteRetentionPolicy": {
          "enabled": true,
          "days": "[parameters('blobSoftDeleteDays')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('names').storage)]"
      ]
    },
    {
      "copy": {
        "name": "blobContainers",
        "count": "[length(variables('containers'))]"
      },
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('names').storage, 'default', variables('containers')[copyIndex()])]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('names').storage, 'default')]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('names').logs]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": "[parameters('logAnalyticsRetentionDays')]",
        "workspaceCapping": {
          "dailyQuotaGb": "[parameters('logAnalyticsDailyQuotaGb')]"
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('names').appInsights]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('names').logs)]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('names').logs)]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('names').openAi]",
      "location": "[parameters('openAiLocation')]",
      "tags": "[variables('allTags')]",
      "kind": "OpenAI",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "customSubDomainName": "[variables('names').openAi]",
        "publicNetworkAccess": "[variables('publicAccess')]",
        "networkAcls": {
          "defaultAction": "[if(parameters('privateNetworking'), 'Deny', 'Allow')]"
        }
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('names').openAi, parameters('embeddingModelName'))]",
      "sku": {
        "name": "[parameters('embeddingDeploymentSku')]",
        "capacity": "[parameters('embeddingCapacity')]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('embeddingModelName')]",
          "version": "[parameters('embeddingModelVersion')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('names').openAi)]"
      ]
    },
    {
      "type": "Microsoft.Search/searchServices",
      "apiVersion": "2023-11-01",
      "name": "[variables('names').search]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "sku": {
        "name": "[parameters('searchSku')]"
      },
      "properties": "[union(createObject('replicaCount', parameters('searchReplicas'), 'partitionCount', parameters('searchPartitions'), 'hostingMode', 'default', 'publicNetworkAccess', if(parameters('privateNetworking'), 'disabled', 'enabled'), 'authOptions', createObject('aadOrApiKey', createObject('aadAuthFailureMode', 'http401WithBearerChallenge'))), variables('semanticSetting'))]"
    },
    {
      "condition": "[variables('createPlan')]",
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[variables('names').plan]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('webAppSku')]",
        "tier": "[variables('planTiers')[parameters('webAppSku')]]",
        "capacity": "[parameters('webAppInstanceCount')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "condition": "[parameters('privateNetworking')]",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-01-01",
      "name": "[variables('names').vnet]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "app",
            "properties": {
              "addressPrefix": "[parameters('appSubnetPrefix')]",
              "delegations": [
                {
                  "name": "web",
                  "properties": {
                    "serviceName": "Microsoft.Web/serverFarms"
                  }
                }
              ]
            }
          },
          {
            "name": "private-endpoints",
            "properties": {
              "addressPrefix": "[parameters('privateEndpointSubnetPrefix')]",
              "privateEndpointNetworkPolicies": "Disabled"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[variables('names').web]",
      "location": "[parameters('location')]",
      "tags": "[union(variables('allTags'), createObject('azd-service-name', 'web'))]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[if(variables('createPlan'), resourceId('Microsoft.Web/serverfarms', variables('names').plan), parameters('existingAppServicePlanId'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "keyVaultReferenceIdentity": "SystemAssigned",
        "virtualNetworkSubnetId": "[if(parameters('privateNetworking'), format('{0}/subnets/app', resourceId('Microsoft.Network/virtualNetworks', variables('names').vnet)), null())]",
        "vnetRouteAllEnabled": "[parameters('privateNetworking')]",
        "siteConfig": {
          "linuxFxVersion": "PYTHON|3.12",
          "appCommandLine": "[variables('startupCommand')]",
          "alwaysOn": true,
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "healthCheckPath": "/healthz",
          "vnetRouteAllEnabled": "[parameters('privateNetworking')]",
          "appSettings": [
            {
              "name": "ADVSEARCH_MODE",
              "value": "azure"
            },
            {
              "name": "ENVIRONMENT_NAME",
              "value": "[parameters('environmentName')]"
            },
            {
              "name": "DJANGO_SECRET_KEY",
              "value": "[format('@Microsoft.KeyVault(VaultName={0};SecretName=django-secret-key)', variables('names').keyVault)]"
            },
            {
              "name": "AUTH_MODE",
              "value": "[parameters('authMode')]"
            },
            {
              "name": "DEMO_PASSWORD",
              "value": "[format('@Microsoft.KeyVault(VaultName={0};SecretName=demo-password)', variables('names').keyVault)]"
            },
            {
              "name": "AZURE_STORAGE_ACCOUNT_URL",
              "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('names').storage), '2023-05-01').primaryEndpoints.blob]"
            },
            {
              "name": "CONTAINER_DOCUMENTS",
              "value": "documents"
            },
            {
              "name": "CONTAINER_CONFIG",
              "value": "config"
            },
            {
              "name": "SEARCH_ENDPOINT",
              "value": "[format('https://{0}.search.windows.net', variables('names').search)]"
            },
            {
              "name": "SEARCH_INDEX_NAME",
              "value": "[parameters('searchIndexName')]"
            },
            {
              "name": "AZURE_OPENAI_ENDPOINT",
              "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('names').openAi), '2024-10-01').endpoint]"
            },
            {
              "name": "AZURE_OPENAI_API_VERSION",
              "value": "[parameters('openAiApiVersion')]"
            },
            {
              "name": "EMBEDDING_DEPLOYMENT",
              "value": "[parameters('embeddingModelName')]"
            },
            {
              "name": "EMBEDDING_DIMENSIONS",
              "value": "[string(parameters('embeddingDimensions'))]"
            },
            {
              "name": "MAX_UPLOAD_MB",
              "value": "[string(parameters('maxUploadMb'))]"
            },
            {
              "name": "DISPLAY_TIME_ZONE",
              "value": "[parameters('displayTimeZone')]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
