# Deployment variables for the DEMO environment, read by:  Deployment/scripts/deploy.sh -e demo
# Command-line options override these values. Service sizes (SKUs) are in
# Deployment/ARM/parameters/demo.parameters.json. Do not put secrets in this file.

# Subscription ID or name. Empty = the subscription currently selected in `az account show`.
AZURE_SUBSCRIPTION=""

# Existing resource group for the demo. deploy.sh reuses it and never recreates it.
RESOURCE_GROUP="Vaibhav.Chaudhary"

# Region of the resource group and every service except Azure OpenAI (openAiLocation in the parameters file).
LOCATION="centralindia"

# Host the web app on this existing Linux App Service plan instead of creating one. deploy.sh looks up its
# resource ID (az appservice plan show) and passes it as existingAppServicePlanId. The plan is never modified.
EXISTING_PLAN_NAME="ccai-demo-gqausd-web-plan"
EXISTING_PLAN_RESOURCE_GROUP="Vaibhav.Chaudhary"

# 1 = upload the sample documents (Data/sample_docs) to the documents container after the code deployment;
#     the web app indexes them on start-up. Same as passing --seed.
SEED=1
