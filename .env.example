# Copy to .env. Only the make targets read it (Makefile "include .env"); docker compose and direct python
# commands do not, so export the variables in your shell for those. Everything is optional in local mode.
# See Documents/configuration.md for the full list.

ADVSEARCH_MODE=local            # local | azure

# --- Swap in real Azure services one at a time (the rest stay local) --------------------
# EMBEDDING_BACKEND=azure
# AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com
# AZURE_OPENAI_KEY=<key>        # omit to use your az login
# EMBEDDING_DEPLOYMENT=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536     # also used by the local index; changing it needs `python -m advancesearch reindex`

# SEARCH_BACKEND=azure
# SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# SEARCH_API_KEY=<admin key>    # local experiments only; omit to use your az login
# SEARCH_INDEX_NAME=advance-search-dev

# STORAGE_BACKEND=azure
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true   # Azurite

# --- Web app ---------------------------------------------------------------------------
# AUTH_MODE=password            # password | dev (dev = no password, local mode only)
# DEMO_PASSWORD=change-me
# DJANGO_DEBUG=true             # Django debug error pages (developer machines only; default false)
# MAX_UPLOAD_MB=20
